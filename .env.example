# ─────────────────────────────────────────────────────────────────────────────
# VoxDesk (FastAPI + LangChain) — production configuration
# Copy to .env and fill in what you have. With no keys the app boots in demo
# mode: deterministic LangChain model, simulated voice, browser test line.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=8080
HOST=0.0.0.0
# Public HTTPS origin in production (used in Twilio webhooks and wss URLs).
PUBLIC_URL=http://localhost:8080
LOG_LEVEL=info
DATA_DIR=./data

# Dashboard/API auth. Comma separated. REQUIRED when NODE_ENV=production.
# Generate one: python -c "import secrets;print(secrets.token_urlsafe(24))"
API_KEYS=
CORS_ORIGINS=*
TRUST_PROXY=true

# LLM — any OpenAI-compatible /chat/completions endpoint through LangChain ------
#   LLM_PROVIDER=xai        Grok (https://api.x.ai/v1)
#   LLM_PROVIDER=xkiro      set XKIRO_BASE_URL
#   LLM_PROVIDER=openai     https://api.openai.com/v1
#   LLM_PROVIDER=openrouter https://openrouter.ai/api/v1
#   LLM_PROVIDER=groq       https://api.groq.com/openai/v1
#   LLM_PROVIDER=custom     requires LLM_BASE_URL
# LLM_PROVIDER=xai
# LLM_MODEL=grok-4
# LLM_BASE_URL=https://api.your-gateway.example/v1
# LLM_API_KEY=
# LLM_TEMPERATURE=0.6
# LLM_MAX_TOKENS=320
# LLM_TIMEOUT_MS=20000

# Auto-detection when LLM_PROVIDER is unset (priority order):
XKIRO_API_KEY=
XKIRO_BASE_URL=https://api.xkiro.ai/v1
XAI_API_KEY=
GROK_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=

# Speech to text ---------------------------------------------------------------
# deepgram (streaming, recommended) | openai (batch whisper) | mock
# STT_PROVIDER=deepgram
# STT_MODEL=nova-3
# STT_LANGUAGE=en
# STT_ENDPOINTING_MS=320
DEEPGRAM_API_KEY=

# Text to speech ---------------------------------------------------------------
# elevenlabs | openai | deepgram | mock
# TTS_PROVIDER=elevenlabs
# TTS_MODEL=eleven_flash_v2_5
# TTS_VOICE=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_API_KEY=

# Telephony --------------------------------------------------------------------
# none (browser test line only) | twilio
TELEPHONY_PROVIDER=none
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_VALIDATE_SIGNATURE=true
# Only change for a Twilio-compatible gateway or a local test double.
# TWILIO_API_BASE=https://api.twilio.com

# Agent defaults (editable at runtime in the dashboard) ------------------------
AGENT_NAME=Ava
AGENT_COMPANY=Northwind Labs
AGENT_LANGUAGE=en-US
AGENT_GREETING=Hi, thanks for calling. This is Ava - how can I help you today?
AGENT_FALLBACK=Sorry, I didn't catch that. Could you say that again?
AGENT_PERSONA=You are a warm, efficient voice assistant who handles inbound customer calls. You speak in short, natural sentences and confirm important details before moving on.
# AGENT_MAX_TURNS=40
# AGENT_MAX_CALL_SECONDS=900
# AGENT_BARGE_IN=true
# AGENT_SILENCE_REPROMPT_MS=7000
# AGENT_HANGUP_SILENCE_MS=20000
